# Beheeromgeving (/beheer)
# Kies een lang, uniek wachtwoord. Zonder deze variabele is inloggen niet mogelijk.
ADMIN_PASSWORD=

# Opslag van tekstwijzigingen op Vercel (lokaal niet nodig — daar wordt data/content.json gebruikt).
# Koppel in het Vercel-dashboard "Upstash for Redis" (Storage → Create Database);
# de onderstaande variabelen worden dan automatisch ingevuld.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
